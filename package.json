{
  "name": "chorale",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n renderer,desktop-build,desktop -c cyan,magenta,yellow \"vite --host 127.0.0.1\" \"npm:dev:electron:build\" \"npm:dev:electron:run\"",
    "dev:electron:build": "concurrently -k \"vite build --watch --config vite.main.config.ts\" \"vite build --watch --config vite.preload.config.ts\"",
    "dev:electron:run": "wait-on tcp:127.0.0.1:5173 dist-electron/main.js dist-electron/preload.cjs && nodemon --watch dist-electron --ext js,cjs --delay 250ms --exec \"electron dist-electron/main.js --renderer-url=http://127.0.0.1:5173\"",
    "build": "tsc -b && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "start:electron": "electron dist-electron/main.js",
    "smoke:electron": "node scripts/electron-smoke.mjs",
    "benchmark:zoom": "npm run build && node scripts/zoom-performance.mjs --assert",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@educandu/abc-tools": "^3.0.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "abcjs": "^6.6.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
