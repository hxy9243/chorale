{
  "name": "chorale",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "chorale": "./bin/chorale.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node bin/chorale.mjs",
    "mcp": "node bin/chorale.mjs mcp",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package:codex": "npm run build && node tools/package-codex.mjs",
    "package:antigravity": "node tools/package-antigravity.mjs",
    "package": "npm run package:codex && npm run package:antigravity",
    "lint": "oxlint",
    "test": "node --test test/*.node.mjs && vitest run",
    "test:mcp": "node --test test/*.node.mjs",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "prepare": "npm run build",
    "test:install": "node --test test/install.smoke.mjs",
    "test:usability": "vitest run src/test/usability.test.tsx src/components/__tests__/NewScoreModal.test.tsx",
    "test:eval": "node --test test/agent-eval.node.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@educandu/abc-tools": "^3.0.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mediabunny/aac-encoder": "^1.56.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "abc-utils": "git+https://github.com/hxy9243/abc-utils.git#37f7be407055057c01be0dae51749897d0c29d34",
    "abcjs": "^6.6.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "mediabunny": "^1.56.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typebox": "^1.1.38",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "bin/",
    "server/",
    "dist/",
    "skills/",
    "INSTALL.md",
    "RELEASE.md",
    "CHANGELOG.md",
    "VERSION"
  ],
  "bundleDependencies": [
    "abc-utils"
  ]
}
