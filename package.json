{
  "name": "chorale",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "chorale": "./bin/chorale.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node bin/chorale.mjs",
    "mcp": "node bin/chorale.mjs mcp",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package:codex": "npm run build && node tools/package-codex.mjs",
    "package:antigravity": "node tools/package-antigravity.mjs",
    "package": "npm run package:codex && npm run package:antigravity",
    "lint": "oxlint",
    "test": "node --test test/*.node.mjs && vitest run",
    "test:mcp": "node --test test/*.node.mjs",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "prepare": "npm run build && npm run build:electron",
    "postinstall": "node server/electron-sandbox.mjs --best-effort",
    "test:install": "node --test test/install.smoke.mjs",
    "test:install:git": "node --test test/install-git.smoke.mjs",
    "test:usability": "vitest run src/test/usability.test.tsx src/components/__tests__/NewScoreModal.test.tsx",
    "test:eval": "node --test test/agent-eval.node.mjs",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:electron": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "postbuild:electron": "node server/electron-sandbox.mjs --best-effort",
    "setup:electron-sandbox": "node server/electron-sandbox.mjs",
    "start:electron": "node scripts/dev-electron.mjs --production",
    "run:electron": "npm run dev:electron",
    "smoke:electron": "node scripts/electron-smoke.mjs",
    "setup:scanner": "node scripts/setup-score-scanner.mjs",
    "smoke:scan": "node scripts/scan-import-smoke.mjs",
    "smoke:scan-pages": "node scripts/scan-pages-smoke.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.31",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@educandu/abc-tools": "^3.0.3",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mediabunny/aac-encoder": "^1.62.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "abc-utils": "git+https://github.com/hxy9243/abc-utils.git#83b897bd2569a687c0eca0f4680c28750b7d8379",
    "abcjs": "^6.7.1",
    "electron": "45.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "mediabunny": "^1.61.3",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "streamdown": "2.7.1",
    "typebox": "^1.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.89.0",
    "playwright-core": "1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "files": [
    "bin/",
    "server/",
    "shared/",
    "dist/",
    "dist-electron/",
    "docs/",
    "skills/",
    "INSTALL.md",
    "RELEASE.md",
    "CHANGELOG.md",
    "VERSION"
  ],
  "bundleDependencies": [
    "abc-utils"
  ]
}
